# Защита от атак через цепочку поставок (см. CLAUDE.md, «Зависимости»). Нужен npm >= 11.19.1.

# Ставить только версии, опубликованные не меньше 7 дней назад.
min-release-age=7

# Без git-зависимостей, в том числе транзитивных.
allow-git=none

# Скрипты установки только у пакетов из allowScripts в package.json,
# неразобранный скрипт роняет установку.
strict-allow-scripts=true

audit=true
